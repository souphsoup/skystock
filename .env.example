# Production: Supabase Postgres (Project Settings > Database > Connection string, Transaction pooler)
# Leave unset locally to use the embedded PGlite database in .data/pglite (auto-seeded with demo data).
DATABASE_URL=

# Required in production: long random string for signing session cookies
#   openssl rand -base64 48
SESSION_SECRET=

# Seed demo data on an empty DB (default: true locally, false when DATABASE_URL is set)
# SEED_DEMO=false

# Auto-logout on shared tablets after N idle minutes
# NEXT_PUBLIC_IDLE_MINUTES=15

# Photo storage (delivery notes / waste): Supabase Storage, private bucket
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=sop-stock

# Morning summary (08:00 Bangkok via vercel.json cron). Without these keys it runs as a dry run (server log only).
# CRON_SECRET=            # openssl rand -base64 32; Vercel Cron sends it as "Authorization: Bearer ..."
# APP_URL=https://stock.example.com   # dashboard link in the summary (Vercel production URL is used if unset)
# LINE_CHANNEL_ACCESS_TOKEN=          # LINE Developers > Messaging API > Channel access token (long-lived)
# LINE_CHANNEL_SECRET=                # LINE Developers > Basic settings; verifies webhook calls
# RESEND_API_KEY=
# EMAIL_FROM="SOP-Stock <stock@your-domain.com>"
